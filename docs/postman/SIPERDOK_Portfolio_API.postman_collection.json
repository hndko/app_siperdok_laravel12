                },
                {
                  "key": "document_type_id",
                  "value": "{{document_type_id}}",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Perbaikan dokumen sesuai catatan penilai.",
                  "type": "text"
                },
                {
                  "key": "submit_action",
                  "value": "submit",
                  "type": "text"
                },
                {
                  "key": "document",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "projects",
                "{{project_id}}"
              ]
            }
