{
  "info": {
    "_postman_id": "f2f91d1d-7fc4-4cc6-8c1d-siperdok",
    "name": "📁 SIPERDOK Portfolio REST API",
    "description": "📌 Portfolio API Collection untuk SIPERDOK - Sistem Informasi Persetujuan Dokumen Kelayakan.\n\nCollection ini disusun untuk kebutuhan technical test Full Stack Programmer. Setiap folder menjelaskan alur utama aplikasi: autentikasi Sanctum, pengajuan permohonan dokumen, upload dokumen tervalidasi dan diproses queue, verifikasi administrasi, penilaian, penerbitan certificate, notifikasi, master data, dashboard, dan export laporan.\n\n🔐 Gunakan request Login terlebih dahulu. Token akan otomatis disimpan ke variable `token`.\n🌐 Default base URL: `http://127.0.0.1:8000`.\n👥 Role utama: `pemohon`, `penilai`, dan `admin` untuk master data/export.\n🧵 Queue: upload dokumen dan notifikasi status diproses melalui Laravel Queue.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
