    {
      "name": "⚖️ Assessment / Penilaian",
      "description": "Workflow penilai: mulai review, isi checklist verifikasi administrasi, beri keputusan approved/revision/rejected, dan lihat histori.",
      "item": [
        {
          "name": "▶️ Start Review",
          "description": "Mengubah status permohonan dari `submitted` ke `in_review` dan menetapkan evaluator.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Review administrasi dimulai oleh penilai.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/assessments/{{project_id}}/start-review",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "assessments",
                "{{project_id}}",
                "start-review"
              ]
            }
          }
        },
        {
          "name": "☑️ Get Verification Checklist",
          "description": "Mengambil daftar checklist verifikasi administrasi untuk permohonan yang sedang dinilai.",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/verification-checklists",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "projects",
                "{{project_id}}",
                "verification-checklists"
              ]
            }
          }
        },
        {
          "name": "🧾 Save Verification Checklist",
          "description": "Menyimpan checklist administrasi. Status item mengikuti enum aplikasi, umumnya `passed`, `failed`, atau `not_applicable` sesuai seed checklist.",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"checklist_item_id\": {{checklist_item_id}},\n      \"status\": \"passed\",\n      \"notes\": \"Dokumen identitas dan kelengkapan awal sesuai.\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/verification-checklists",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "projects",
                "{{project_id}}",
                "verification-checklists"
              ]
            }
          }
        },
        {
          "name": "🏁 Submit Assessment Decision",
          "description": "Memberikan keputusan final/lanjutan: `approved`, `revision`, atau `rejected`. Notes wajib minimal 5 karakter.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approved\",\n  \"notes\": \"Dokumen lengkap dan memenuhi syarat administrasi serta teknis.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/assessments/{{project_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "assessments",
                "{{project_id}}"
              ]
            }
          }
        },
        {
          "name": "🕘 Assessment History",
          "description": "Melihat histori approval/log permohonan. Pemohon hanya melihat miliknya, penilai/admin dapat melihat sesuai akses.",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/assessments/history?project_id={{project_id}}&per_page=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "assessments",
                "history"
              ],
              "query": [
                {
                  "key": "project_id",
                  "value": "{{project_id}}"
                },
                {
                  "key": "per_page",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
