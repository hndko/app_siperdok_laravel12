    {
      "name": "📁 Projects / Permohonan Dokumen",
      "description": "Core workflow pemohon: membuat draft, upload dokumen, submit permohonan, melihat detail, mengubah draft/revisi, dan menghapus draft.",
      "item": [
        {
          "name": "📋 List Projects",
          "description": "Mengambil daftar permohonan dengan cursor pagination dan filter status/search/jenis dokumen/tanggal.",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/projects?status=submitted&search=&per_page=15",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "projects"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "submitted"
                },
                {
                  "key": "search",
                  "value": ""
                },
                {
                  "key": "per_page",
                  "value": "15"
                }
              ]
            }
          }
        },
        {
          "name": "🆕 Create Project + Upload Dokumen Queue",
          "description": "Membuat permohonan baru. Field `document` wajib berupa file pdf/doc/docx/png/jpg/jpeg maksimal 10 MB. Setelah validasi, upload diproses melalui Laravel Queue.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.id) pm.collectionVariables.set('project_id', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Dokumen Kelayakan Lingkungan Pabrik ABC",
                  "type": "text"
                },
                {
                  "key": "document_type_id",
                  "value": "{{document_type_id}}",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Pengajuan persetujuan dokumen kelayakan untuk kegiatan pembangunan.",
                  "type": "text"
                },
                {
                  "key": "submit_action",
                  "value": "submit",
                  "type": "text"
                },
                {
                  "key": "document",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "projects"
              ]
            }
          }
        },
        {
          "name": "🔍 Show Project Detail",
          "description": "Mengambil detail permohonan, dokumen pendukung, pemohon, penilai, status, dan histori assessment.",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "projects",
                "{{project_id}}"
              ]
            }
          }
        },
        {
          "name": "🛠️ Update Draft / Revision Project",
          "description": "Mengubah permohonan selama status masih `draft` atau `revision`. Jika ada file baru, file masuk queue upload sebagai versi dokumen berikutnya.",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Dokumen Kelayakan Lingkungan Pabrik ABC - Revisi",
