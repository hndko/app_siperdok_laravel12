      "key": "project_id",
      "value": "1"
    },
    {
      "key": "document_type_id",
      "value": "1"
    },
    {
      "key": "user_id",
      "value": "1"
    },
    {
      "key": "notification_id",
      "value": "1"
    },
    {
      "key": "certificate_number",
      "value": "CERT-202608-00001"
    },
    {
      "key": "checklist_item_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "🔐 Authentication",
      "description": "Endpoint publik dan endpoint sesi untuk autentikasi REST API berbasis Laravel Sanctum.",
      "item": [
        {
          "name": "🔑 Login - Simpan Bearer Token",
          "description": "Login user dan simpan `access_token` ke variable collection `token`. Gunakan akun demo dari seeder, misalnya pemohon/penilai/admin sesuai data lokal.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login berhasil dan token tersedia', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.access_token).to.be.a('string');",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pemohon@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "login"
              ]
            }
          }
        },
        {
          "name": "📝 Register Pemohon",
          "description": "Mendaftarkan user baru dengan role default `pemohon`. Token registrasi akan otomatis disimpan jika response sukses.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pemohon Portfolio\",\n  \"email\": \"pemohon.portfolio@example.com\",\n  \"phone\": \"081234567890\",\n  \"nip_nik\": \"3276010203040001\",\n  \"company_name\": \"PT Portfolio Dokumen Sejahtera\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "register"
              ]
            }
          }
        },
        {
          "name": "👤 Me - User Aktif",
          "description": "Mengambil profil user aktif, role, dan ringkasan notifikasi untuk kebutuhan layout Vue SPA.",
          "request": {
